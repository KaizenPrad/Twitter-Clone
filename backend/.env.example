# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/twitter-clone

# JWT Secrets (twitter-clone's own auth — NOT sentinel's)
JWT_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# ---- CyberSentinel (threat monitoring, optional but recommended) ----
# URL = where YOUR CyberSentinel backend runs.
# VERIFIED 03-Oct-2026: this key works against http://localhost:5000 (local Cyber backend).
# PORT CLASH WARNING: this twitter app also defaults to 5000.
# For simultaneous local run, start ONE of them on another port, e.g.:
#   Twitter on 8000:  set PORT=8000 && npm run dev   (then SENTINEL_URL=http://localhost:5000), OR
#   Sentinel on 5001:  set PORT=5001 in D:\Cyber\backend (then SENTINEL_URL=http://localhost:5001 — same DB, key still valid)
# Deployed:  e.g. https://your-sentinel.onrender.com (no trailing slash)
SENTINEL_URL=http://localhost:5000
# API key created via: POST /api/auth/api-keys  (header: Authorization: Bearer <owner-JWT>)
# Full key shown ONCE at creation (cs_live_...). Never commit the real key.
SENTINEL_API_KEY=cs_live_REPLACE_ME
